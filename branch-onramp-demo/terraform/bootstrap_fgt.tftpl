config system global
  set hostname "${hostname}"
  # Admin GUI off 443 — IKE-over-TCP (on-ramp) binds 443 and RSTs the GUI's TLS otherwise.
  set admin-sport ${admin_sport}
end
config system admin
  edit "admin"
    set password "${admin_password}"
  next
end
config system interface
  edit "port1"
    set alias "WAN"
    set mode static
    set ip ${wan_ip} ${wan_mask}
    set allowaccess ping https ssh fgfm
  next
  edit "port2"
    set alias "LAN"
    set mode static
    set ip ${lan_ip} ${lan_mask}
    set allowaccess ping https ssh
  next
end
config router static
  edit 1
    set gateway ${wan_gw}
    set device "port1"
  next
%{ if mgmt_route_enabled ~}
  # Pin the trusted management source out the WAN. Longest-prefix match beats the
  # default route the FortiSASE on-ramp injects into the IPsec tunnel, so admin
  # (GUI/SSH) return traffic stays on port1 and management never drops when the
  # tunnel comes up. Keep this pinned to port1 even if port1 joins an SD-WAN zone.
  edit 10
    set dst ${mgmt_route_dst} ${mgmt_route_mask}
    set gateway ${wan_gw}
    set device "port1"
    set comment "mgmt return path - survives on-ramp injected default"
  next
%{ endif ~}
end
config system dns
  set primary 8.8.8.8
  set secondary 8.8.4.4
end
config firewall policy
  edit 1
    set name "LAN-to-WAN"
    set srcintf "port2"
    set dstintf "port1"
    set srcaddr "all"
    set dstaddr "all"
    set action accept
    set schedule "always"
    set service "ALL"
    set nat enable
  next
end
%{ if flex_token != "" ~}
# FortiFlex token supplied via tfvars for ${hostname}. Apply after first boot:
#   execute vm-license ${flex_token}
%{ endif ~}
# NOTE: SD-WAN / IPsec / BGP to the FortiSASE on-ramps is configured by the
# operator after the VM is up + licensed. This bootstrap is network/admin only.
